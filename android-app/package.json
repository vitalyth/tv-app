{
  "name": "tv-app-v2-android-tv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "build:vega:debug": "npm --prefix platforms/vega run build:debug",
    "build:vega:release": "npm --prefix platforms/vega run build:release",
    "lint": "eslint . --ext .js,.ts,.tsx --ignore-pattern platforms/vega",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "react": "19.2.0",
    "react-native": "npm:react-native-tvos@0.83.6-0",
    "react-native-video": "6.19.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
